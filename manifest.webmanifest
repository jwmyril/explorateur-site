      "url": "/couches.html" },
    { "name": "Comparer des territoires", "short_name": "Comparer",
      "url": "/?onglet=comparaison" },
    { "name": "Classement des communes", "short_name": "Classement",
      "url": "/?onglet=classement" }
  ]
