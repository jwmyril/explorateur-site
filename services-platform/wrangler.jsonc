{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atmart-explorateur-services",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_EXPLORER_URL": "https://explorateur.atmart.ltd"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atmart-explorateur-services",
      "database_id": "local-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_FILES",
      "bucket_name": "atmart-explorateur-private"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
